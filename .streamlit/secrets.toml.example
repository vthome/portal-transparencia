# Copie para .streamlit/secrets.toml (local) — NUNCA commite o secrets.toml.
# No Streamlit Cloud, cole este mesmo conteúdo em: App > Settings > Secrets.

# Endereço da API no Render (sem barra no final). Local: http://127.0.0.1:8000
API_URL = "https://monitor-transparencia-api.onrender.com"

# Mesmo valor do API_TOKEN_REVISAO do Render. Sem ele, a página de revisão fica só leitura.
API_TOKEN_REVISAO = "cole-aqui-o-token-do-render"

# Senha que o revisor digita no dashboard para liberar o formulário de revisão.
# O app do Streamlit Cloud é público: sem esta senha, qualquer visitante poderia gravar revisões.
REVISAO_SENHA = "troque-por-uma-senha-para-os-revisores"
