# Copie para .env (nunca commite o .env)
# Supabase > Project Settings > Database > Connection string (URI).
# Para GitHub Actions use o "Session pooler" (porta 5432) ou "Transaction pooler" (6543).
DATABASE_URL=postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Supabase > Project Settings > API Keys
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...      # só no servidor/CI, nunca no dashboard (aceita também a legada service_role)
SUPABASE_BUCKET=snapshots              # criado pelo sql/schema.sql

CRAWLER_USER_AGENT=MonitorTransparenciaBot/0.1 (+https://github.com/SEU_USUARIO/portal-transparencia; contato@exemplo.com)
COLETA_REQ_POR_SEGUNDO=1
COLETA_MAX_PAGINAS=60
COLETA_MAX_PROFUNDIDADE=3
COLETA_MAX_ARQUIVOS=30
COLETA_FRACAO_PORTAL=0.5            # metade das páginas reservada ao portal da transparência
COLETA_PARALELISMO=3
COLETA_RENDERIZAR=true
COLETA_SCREENSHOTS=true

# --- Camada 2: embeddings ---
# A coluna monitor.chunk.embedding é vector(768) a partir do schema v0.3; modelo e EMBEDDINGS_DIM
# precisam bater com ela (o pipeline confere e para antes de gravar se não baterem).
EMBEDDINGS_MODELO=PORTULAN/serafim-100m-portuguese-pt-sentence-encoder-ir
# alternativa multilíngue, também 768: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDINGS_DIM=768
EMBEDDINGS_LOTE=32
# EMBEDDINGS_DEVICE=cpu          # ou cuda; vazio = automático

# --- Camada 3: API (no Render, configure em Environment; aqui só para rodar local) ---
API_TOKEN_REVISAO=troque-por-um-valor-longo   # X-API-Key exigida no POST /revisoes (o Streamlit usa)
# API_TOKEN_LEITURA=                          # se definido, todas as rotas (menos /health) exigem X-API-Key
API_BUSCA=texto                               # texto | modelo (SERAFIM na API: ~1,5 GB de RAM)
# API_CORS_ORIGINS=https://seu-app.streamlit.app
# API_POOL_MAX=5
