# Copie para .env (nunca commite o .env)
# Supabase > Project Settings > Database > Connection string (URI).
# Para GitHub Actions use o "Session pooler" (porta 5432) ou "Transaction pooler" (6543).
DATABASE_URL=postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Supabase > Project Settings > API Keys
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...      # só no servidor/CI, nunca no dashboard (aceita também a legada service_role)
SUPABASE_BUCKET=snapshots              # criado pelo sql/schema.sql

CRAWLER_USER_AGENT=MonitorTransparenciaBot/0.1 (+https://github.com/SEU_USUARIO/portal-transparencia; contato@exemplo.com)
COLETA_REQ_POR_SEGUNDO=1
COLETA_MAX_PAGINAS=60
COLETA_MAX_PROFUNDIDADE=3
COLETA_MAX_ARQUIVOS=30
COLETA_FRACAO_PORTAL=0.5            # metade das páginas reservada ao portal da transparência
COLETA_PARALELISMO=3
COLETA_RENDERIZAR=true
COLETA_SCREENSHOTS=true
